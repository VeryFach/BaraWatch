# Salin menjadi .env; jangan commit .env
APP_NAME=BaraWatch AI
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO
# Kosong hanya di development; wajib kuat di staging/production.
AI_INTERNAL_KEY=
FIRMS_MAP_KEY=
BARAWATCH_AI_API_KEY=
BARAWATCH_DEVICE=auto
MFRAZON_MODEL_PATH=models/weights/fire_smoke_yolov8.pt
TOUATI_MODEL_PATH=models/weights/model.pt
MFRAZON_CONFIDENCE=0.10
TOUATI_CONFIDENCE=0.10
MFRAZON_IOU=0.50
TOUATI_IOU=0.50
MFRAZON_IMAGE_SIZE=640
TOUATI_IMAGE_SIZE=640